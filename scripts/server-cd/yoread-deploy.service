[Unit]
Description=Publish Yoread from the protected main branch
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/yoread-cd/deploy.py /root/kim_workspace/yoread
TimeoutStartSec=120s
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/root/kim_workspace/yoread
